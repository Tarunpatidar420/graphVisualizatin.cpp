#include <iostream>
#include <vector>
#include <list>
#include <fstream>
#include <cstdlib>

using namespace std;

class Graph
{
public:
    int vertex;
    bool isDirected;

    vector<list<pair<int, int>>> graph;

    Graph(int vertex, bool isDirected = false)
    {
        this->vertex = vertex;
        this->isDirected = isDirected;

        graph.resize(vertex);
    }

    //---------------- Add Edge ----------------//
    void addEdge(int source, int destination, int weight)
    {
        graph[source].push_back({destination, weight});

        // Undirected Graph
        if (!isDirected)
        {
            graph[destination].push_back({source, weight});
        }
    }

    //---------------- Display ----------------//
    void display()
    {
        cout << "\n========== Adjacency List ==========\n\n";

        for (int i = 0; i < vertex; i++)
        {
            cout << i << " -> ";

            for (auto edge : graph[i])
            {
                cout << "("
                     << edge.first << ","
                     << edge.second << ") ";
            }

            cout << endl;
        }
    }
};

//---------------- Visualization ----------------//

void visualizeGraph(Graph &g, string fileName = "graph.dot")
{
    ofstream file(fileName);

    file << "digraph G {\n";

    file << "layout=dot;\n";
    file << "rankdir=LR;\n";

    file << "size=\"22,16!\";\n";
    file << "dpi=300;\n";

    file << "nodesep=1.8;\n";
    file << "ranksep=2.2;\n";

    file << "splines=true;\n";
    file << "overlap=false;\n";
    file << "concentrate=false;\n";

    // Nodes
    for (int i = 0; i < g.vertex; i++)
    {
        file << i
             << " [shape=circle,"
             << "style=filled,"
             << "fillcolor=lightblue,"
             << "color=black,"
             << "penwidth=2,"
             << "width=0.8,"
             << "height=0.8,"
             << "fontsize=18];\n";
    }

    vector<vector<bool>> visited(g.vertex,
                                 vector<bool>(g.vertex, false));

    // Edges
    for (int i = 0; i < g.vertex; i++)
    {
        for (auto edge : g.graph[i])
        {
            int dest = edge.first;
            int weight = edge.second;

            if (g.isDirected)
            {
                file << i << " -> " << dest
                     << " [label=\"" << weight
                     << "\",color=red,"
                     << "fontcolor=red,"
                     << "penwidth=2.5,"
                     << "fontsize=16,"
                     << "arrowsize=1.3];\n";
            }
            else
            {
                if (!visited[i][dest])
                {
                    file << i << " -> " << dest
                         << " [dir=none,"
                         << "label=\"" << weight
                         << "\",color=blue,"
                         << "fontcolor=blue,"
                         << "penwidth=2.5,"
                         << "fontsize=16];\n";

                    visited[i][dest] = true;
                    visited[dest][i] = true;
                }
            }
        }
    }

    file << "}\n";

    file.close();

    string png = fileName.substr(0, fileName.find('.')) + ".png";

    string cmd1 = "dot -Tpng " + fileName + " -o " + png;
    system(cmd1.c_str());

    string cmd2 = "start " + png;
    system(cmd2.c_str());
}

//---------------- Main ----------------//

int main()
{
    bool directed;

    cout << "Enter Graph Type (1 = Directed, 0 = Undirected): ";
    cin >> directed;

    Graph g(6, directed);

    g.addEdge(0, 1, 5);
    g.addEdge(0, 4, 3);
    g.addEdge(1, 3, 7);
    g.addEdge(3, 4, 4);
    g.addEdge(4, 5, 2);
    g.addEdge(3, 5, 6);

    g.display();

    visualizeGraph(g);

    return 0;
}
